---
import type { GetStaticPaths } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { Check } from '@lucide/astro'
import Base from '@/layouts/Base.astro'
import PageHero from '@/components/PageHero.astro'
import InquiryForm from '@/components/InquiryForm.astro'
import ListingCard from '@/components/ListingCard.astro'
import GuidesGrid from '@/components/GuidesGrid.astro'
import { getActiveListings, getAreas, inArea } from '@/lib/listings'
import { SITE_URL, contact, pad2 } from '@/lib/site'

export const getStaticPaths = (async () => {
  const guides = await getCollection('guides')
  return guides.map((guide) => ({ params: { guide: guide.id }, props: { guide } }))
}) satisfies GetStaticPaths

const { guide } = Astro.props as { guide: CollectionEntry<'guides'> }
const g = guide.data

// Related listings: all land, or everything in a named area.
let related = [] as Awaited<ReturnType<typeof getActiveListings>>
if (g.related) {
  const active = await getActiveListings()
  if (g.related === 'land') related = active.filter((l) => l.data.type === 'land')
  else {
    const area = (await getAreas()).find((a) => a.id === g.related)
    if (area) related = active.filter((l) => inArea(l, area)).slice(0, 6)
  }
}

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.title,
  description: g.summary,
  url: new URL(`/${guide.id}`, SITE_URL).href,
  author: { '@type': 'Person', name: contact.name },
  publisher: { '@id': `${SITE_URL}/#agent` },
}
---

<Base title={g.metaTitle} description={g.summary} jsonLd={ld}>
  <PageHero eyebrow={g.eyebrow} title={g.title} intro={g.intro} crumbs={[{ label: 'Guides', href: '/guides' }, { label: g.cardTitle }]} />

  <section class="bg-secondary py-16 text-foreground md:py-24">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <ol class="flex flex-col gap-8">
          {
            g.points.map((point, i) => (
              <li data-reveal style={`--reveal-delay:${i * 60}ms`} class="flex gap-6 border-t border-foreground/15 pt-6">
                <span aria-hidden="true" class="font-display text-3xl font-medium text-gold">{pad2(i + 1)}</span>
                <p class="text-lg leading-relaxed text-muted-foreground text-pretty">{point}</p>
              </li>
            ))
          }
        </ol>

        {
          g.situations && (
            <div data-reveal class="mt-14 border border-border bg-background p-6 md:p-8">
              <h2 class="font-display text-2xl tracking-wide">Is this you?</h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {g.situations.map((s) => (
                  <li class="flex items-start gap-3 text-muted-foreground">
                    <Check class="mt-0.5 size-5 shrink-0 text-gold" aria-hidden="true" />
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {g.outro && <p data-reveal class="mt-12 max-w-2xl text-lg leading-relaxed text-foreground text-pretty">{g.outro}</p>}
      </div>

      <aside class="lg:col-span-5">
        <div data-reveal style="--reveal-delay:150ms" class="lg:sticky lg:top-28">
          <div class="rounded-sm border border-border bg-background p-6 text-foreground md:p-8">
            <p class="eyebrow text-muted-foreground">{g.cta.eyebrow}</p>
            <h2 class="mt-3 font-display text-xl tracking-wide">{g.cta.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{g.cta.body}</p>
            <div class="mt-6">
              <InquiryForm goal={g.cta.goal} dark={false} compact />
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="bg-background py-16 md:py-24" aria-labelledby="related-heading">
        <div class="shell">
          <div data-reveal class="flex items-end justify-between gap-6">
            <h2 id="related-heading" class="text-3xl font-medium tracking-wide md:text-4xl">
              {g.related === 'land' ? 'Land on the market now' : 'On the market now'}
            </h2>
            <a href="/properties" class="label shrink-0 text-muted-foreground hover:text-gold">View all →</a>
          </div>
          <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((l, i) => <ListingCard listing={l} index={i} />)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-border bg-background py-16 md:py-24">
    <div class="shell">
      <h2 data-reveal class="text-3xl font-medium tracking-wide md:text-4xl">More guides</h2>
      <div class="mt-10"><GuidesGrid exclude={guide.id} /></div>
    </div>
  </section>
</Base>
