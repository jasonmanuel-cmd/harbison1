---
import { Image } from 'astro:assets'
import { ArrowRight } from '@lucide/astro'
import Base from '@/layouts/Base.astro'
import PageHero from '@/components/PageHero.astro'
import { getActiveListings, getAreas, inArea, marketStats } from '@/lib/listings'
import { photo } from '@/lib/photos'
import { formatPriceShort } from '@/lib/site'

const [areas, listings] = await Promise.all([getAreas(), getActiveListings()])
---

<Base
  title="Tehachapi & Bakersfield Neighborhoods"
  description="Explore Tehachapi, Stallion Springs, Golden Hills, Cummings Valley, Bakersfield, Seven Oaks, and Stockdale — with current listings and median asking prices."
  image={photo('28751-gleneagle-ct-1')}
>
  <PageHero
    eyebrow="Where we work"
    title="Neighborhoods"
    intro="Mountain and valley. Four seasons at 3,970 feet, or established neighborhoods and gated enclaves on the valley floor. Every number here comes from current listings."
    image={photo('28751-gleneagle-ct-1')}
    crumbs={[{ label: 'Neighborhoods' }]}
  />
  <section class="bg-background py-16 md:py-24">
    <ul class="shell grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        areas.map((area, i) => {
          const stats = marketStats(listings.filter((l) => inArea(l, area)))
          return (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`} class:list={[i === 0 && 'sm:col-span-2 lg:col-span-2']}>
              <a href={`/areas/${area.id}`} class="group relative flex aspect-[4/3] h-full w-full items-end overflow-hidden bg-ink text-ink-foreground">
                <Image src={photo(area.data.photo)} alt="" widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 40vw, 100vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] group-hover:scale-105" />
                <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/30 to-transparent" />
                <span class="relative flex w-full flex-col gap-2 p-6 md:p-8">
                  <span class="eyebrow text-[0.65rem] text-poppy">{area.data.tag}</span>
                  <span class="font-display text-3xl tracking-wide md:text-4xl">{area.data.name}</span>
                  <span class="max-w-md text-sm text-ink-foreground/80">{area.data.body}</span>
                  <span class="label mt-2 flex items-center justify-between gap-4 text-xs text-ink-foreground/75">
                    <span>{stats.count ? `${stats.count} listed · median ${formatPriceShort(stats.median)}` : 'Ask about upcoming listings'}</span>
                    <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                  </span>
                </span>
              </a>
            </li>
          )
        })
      }
    </ul>
  </section>
</Base>
