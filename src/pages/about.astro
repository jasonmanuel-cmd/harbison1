---
import { Image } from 'astro:assets'
import { ArrowUpRight } from '@lucide/astro'
import Landing from '@/layouts/Landing.astro'
import ProfileLinks from '@/components/ProfileLinks.astro'
import headshot from '@/assets/headshot.webp'
import about from '@/data/about.json'
import { contact, values } from '@/lib/site'
---
<Landing title="Meet Nathanael Harbison | Harbison Standard" description="Get to know Nathanael Harbison, California REALTOR® DRE #02059393. His background, approach, and work with buyers, sellers, and investors across Kern County." image={headshot} imageAlt="Nathanael Harbison">
  <section class="intro wrap" aria-labelledby="bio-title">
    <div><p class="kicker">The person behind Harbison Standard</p><h1 id="bio-title">Meet<br /><span>Nathanael Harbison.</span></h1><p class="intro-text">A practical perspective shaped by real estate, development, and a long-term view of value — and plain talk about what makes sense.</p><a class="contact-button" href={contact.phoneHref}>Let’s talk <ArrowUpRight size={19} /></a><p class="license">California REALTOR® · DRE #{contact.dre}</p></div>
    <figure class="portrait"><Image src={headshot} alt="Nathanael Harbison, REALTOR®" widths={[400,640,900]} sizes="(max-width:760px) 90vw,42vw" loading="eager" fetchpriority="high" /><figcaption>Nathanael Harbison <span>Harbison Standard</span></figcaption></figure>
  </section>
  <section class="wrap bio-body" aria-labelledby="background-title"><p class="kicker">Background & approach</p><h2 id="background-title">Listening first. Looking ahead.</h2><div class="bio-copy" style="max-width:820px;margin-top:28px">{about.paragraphs.map(paragraph => <p>{paragraph}</p>)}<p><a href={contact.licenseUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">View Nathanael’s California DRE license record #{contact.dre}<span class="sr-only"> (opens in a new tab)</span></a></p></div></section>
  <section class="standard" aria-labelledby="values-title"><div class="wrap"><p class="kicker">What you can expect</p><h2 id="values-title">A standard built around people.</h2><dl class="grid gap-8 mt-8 sm:grid-cols-2">{values.map(value => <div><dt class="font-display text-xl font-semibold">{value.title}</dt><dd class="mt-3 leading-relaxed">{value.body}</dd></div>)}</dl></div></section>
  <ProfileLinks />
</Landing>
