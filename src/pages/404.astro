---
import Base from '@/layouts/Base.astro'
---

<Base title="Page not found" description="That page doesn’t exist. Meet Nathanael Harbison at Harbison Standard." noindex bare>
  <section class="relative isolate flex min-h-svh items-center overflow-hidden bg-ink text-ink-foreground">
    <div class="shell py-32">
      <p class="eyebrow text-poppy">404</p>
      <h1 class="mt-5 max-w-3xl text-5xl font-medium leading-tight tracking-wide md:text-7xl">This page is no longer available.</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-foreground/75">This page may have been retired. Explore Harbison Standard or meet Nathanael to find out more.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="pill border border-ink-foreground/60 hover:bg-ink-foreground hover:text-ink">Back home</a>
        <a href="/about" class="pill border border-ink-foreground/60 hover:bg-ink-foreground hover:text-ink">Meet Nathanael</a>
      </div>
    </div>
  </section>
</Base>
