---
import Base from '@/layouts/Base.astro'
---

<Base title="Page not found" description="That page doesn’t exist. Explore current properties across Kern County." noindex>
  <section class="relative isolate flex min-h-svh items-center overflow-hidden bg-ink text-ink-foreground">
    <div class="shell py-32">
      <p class="eyebrow text-poppy">404</p>
      <h1 class="mt-5 max-w-3xl text-5xl font-medium leading-tight tracking-wide md:text-7xl">Wide open land. No page here.</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-foreground/75">The page you’re looking for has moved or never existed. The properties haven’t.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/properties" class="pill bg-poppy text-ink hover:bg-ink-foreground">View properties</a>
        <a href="/" class="pill border border-ink-foreground/60 hover:bg-ink-foreground hover:text-ink">Back home</a>
      </div>
    </div>
  </section>
</Base>
