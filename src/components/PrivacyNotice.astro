---
import { contact } from '@/lib/site'
import { t, type Lang } from '@/i18n'

interface Props {
  lang?: Lang
}
const { lang = 'en' } = Astro.props
const copy = t(lang).privacy
---
<details id="privacy" class="footer-privacy">
  <summary>{copy.summary}</summary>
  <div class="privacy-copy">
    <p>{copy.p1}</p>
    <p>{copy.p2}</p>
    <p>{copy.p3}</p>
    <button type="button" data-privacy-optout data-disabled-label={copy.disabled} data-no-storage-label={copy.disabledNoStorage}>{copy.optOut}</button>
    <p>{copy.p4Before}<a href={`mailto:${contact.email}`}>{contact.email}</a>{copy.p4After}</p>
  </div>
</details>

<script>
  import { analyticsAllowed, optOutOfAnalytics } from '@/scripts/analytics'

  const notice = document.querySelector<HTMLDetailsElement>('#privacy')
  const button = notice?.querySelector<HTMLButtonElement>('[data-privacy-optout]')
  const disabled = () => {
    if (!button) return
    button.textContent = button.dataset.disabledLabel ?? ''
    button.disabled = true
  }
  if (!analyticsAllowed()) disabled()
  button?.addEventListener('click', () => {
    const saved = optOutOfAnalytics()
    disabled()
    if (button && !saved) button.textContent = button.dataset.noStorageLabel ?? ''
  })
  const openLinkedNotice = () => {
    if (notice && location.hash === '#privacy') notice.open = true
  }
  openLinkedNotice()
  window.addEventListener('hashchange', openLinkedNotice)
</script>

<style>
  .footer-privacy{flex-basis:100%;border-top:1px solid #ffffff26;padding-top:10px;margin-top:4px;font-size:12px;line-height:1.8}
  summary{cursor:pointer;min-height:44px;align-content:center;width:fit-content;color:#d7dce5}
  .privacy-copy{max-width:820px;padding-bottom:12px;font-size:13px;color:#d7dce5}
  .privacy-copy p+p{margin-top:14px}.privacy-copy a{overflow-wrap:anywhere;text-decoration:underline;text-underline-offset:3px}
  button{display:block;min-height:44px;margin-block:12px;text-decoration:underline;text-underline-offset:4px;cursor:pointer;color:#f1d68a}
  button:disabled{cursor:default;text-decoration:none;color:#d7dce5}
</style>
