---
import InquiryForm from './InquiryForm.astro'
import { contact } from '@/lib/site'

interface Props {
  heading?: string
  headingLevel?: 'h1' | 'h2'
}
const { heading = 'Good things start with a conversation.', headingLevel: H = 'h2' } = Astro.props
---

<section id="contact" aria-labelledby="contact-heading" class="relative scroll-mt-16 bg-ink py-24 text-ink-foreground md:py-32">
  <div class="shell">
    <p class="eyebrow text-ink-foreground/60">Direct line · Call or text</p>
    <a href={contact.phoneHref} class="mt-5 block font-display text-[clamp(2.5rem,8vw,7rem)] font-medium leading-none tracking-wide tabular-nums transition-colors hover:text-poppy">
      {contact.phone}
    </a>

    <div class="mt-16 grid gap-12 border-t border-ink-foreground/20 pt-12 lg:grid-cols-12">
      <div class="flex flex-col gap-6 lg:col-span-5">
        <H id="contact-heading" class="text-4xl font-medium leading-tight tracking-wide text-balance md:text-5xl">{heading}</H>
        <p class="max-w-md leading-relaxed text-ink-foreground/70">
          Buying your first home, planning a sale, or seeing potential in a property? Tell Nathanael what you have in mind. Most messages get a reply
          personally.
        </p>
        <ul class="label flex flex-col">
          <li>
            <a href={contact.smsHref} class="inline-flex min-h-11 items-center underline decoration-poppy decoration-2 underline-offset-8 hover:text-poppy">Send a text</a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="inline-flex min-h-11 items-center break-all underline decoration-poppy decoration-2 underline-offset-8 hover:text-poppy">
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
      <div class="rounded-sm border border-ink-foreground/20 bg-ink-foreground/[0.03] p-6 md:p-10 lg:col-span-7">
        <InquiryForm />
      </div>
    </div>
  </div>
</section>
