---
import { getImage } from 'astro:assets'
import poster from '@/assets/hero-poster.jpg'

const posterImg = await getImage({ src: poster, width: 1920, format: 'webp', quality: 72 })
const posterMobile = await getImage({ src: poster, width: 900, format: 'webp', quality: 70 })

const split = (word: string, start: number) => word.split('').map((char, i) => ({ char, delay: start + i * 55 }))
---

<section id="top" aria-labelledby="hero-heading" class="relative flex h-svh min-h-[36rem] items-center justify-center overflow-hidden bg-ink text-ink-foreground">
  <hero-video aria-hidden="true" class="absolute inset-0 block">
    <img
      src={posterImg.src}
      srcset={`${posterMobile.src} 900w, ${posterImg.src} 1920w`}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <video
      class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 data-[ready]:opacity-100"
      muted
      loop
      playsinline
      preload="none"
      data-src="/video/hero.mp4"
      poster={posterImg.src}></video>
  </hero-video>

  <div aria-hidden="true" class="absolute inset-x-0 top-0 z-[2] h-[45%] bg-gradient-to-b from-ink/80 via-ink/35 to-transparent md:h-[55%] md:from-ink/75 md:via-ink/40"></div>
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 z-[2] h-[45%] bg-gradient-to-t from-ink/90 via-ink/50 to-transparent md:h-40 md:from-ink/70"></div>

  <div class="shell relative z-10 flex h-full flex-col justify-between pb-[max(5.25rem,calc(env(safe-area-inset-bottom)+4.5rem))] pt-24 md:justify-start md:gap-5 md:pb-0 md:pt-[17vh]">
    <div class="flex flex-col items-center text-center">
      <p class="eyebrow rise text-[0.65rem] tracking-[0.2em] text-ink-foreground/85 sm:text-xs sm:tracking-[0.32em]" style="animation-delay:200ms">
        Tehachapi · Bakersfield · Kern County
      </p>
      <h1
        id="hero-heading"
        aria-label="Harbison Standard"
        class="mt-3 flex flex-col items-center font-display text-[clamp(2rem,10vw,4.5rem)] font-extrabold uppercase leading-[0.9] tracking-[-0.04em] md:mt-4 md:flex-row md:gap-[0.3em] md:text-[clamp(2.5rem,4.6vw,4.5rem)]"
      >
        <span aria-hidden="true" class="block overflow-hidden whitespace-nowrap px-[0.04em] pb-[0.06em]">
          {split('Harbison', 250).map(({ char, delay }) => <span class="letter" style={`animation-delay:${delay}ms`}>{char}</span>)}
        </span>
        <span aria-hidden="true" class="block overflow-hidden whitespace-nowrap px-[0.04em] pb-[0.06em]">
          {split('Standard', 650).map(({ char, delay }) => <span class="letter gold-outline" style={`animation-delay:${delay}ms`}>{char}</span>)}
        </span>
      </h1>
    </div>

    <div class="flex flex-col items-center text-center">
      <p class="rise flex flex-wrap items-center justify-center gap-x-2 text-pretty text-base leading-snug text-ink-foreground/95 sm:text-lg md:text-xl" style="animation-delay:1300ms">
        <span>It’s not what you do.</span>
        <span>It’s <span class="font-display font-bold italic text-poppy">how</span> you do it.</span>
      </p>
      <div class="rise mt-4 flex w-full max-w-sm gap-2 sm:w-auto sm:max-w-none sm:gap-3 md:mt-5" style="animation-delay:1000ms">
        <a href="/properties" class="pill min-w-0 flex-1 whitespace-nowrap bg-poppy px-3 text-[0.68rem] tracking-[0.12em] text-ink hover:bg-ink-foreground sm:flex-none sm:px-8 sm:text-xs sm:tracking-[0.2em]">
          View properties
        </a>
        <a href="/contact" class="pill min-w-0 flex-1 whitespace-nowrap border border-ink-foreground/70 px-3 text-[0.68rem] tracking-[0.12em] hover:border-ink-foreground hover:bg-ink-foreground hover:text-ink sm:flex-none sm:px-8 sm:text-xs sm:tracking-[0.2em]">
          Let’s connect
        </a>
      </div>
    </div>
  </div>

  <a href="#standard" class="absolute bottom-8 right-8 z-10 hidden flex-col items-center gap-3 md:flex" aria-label="Scroll to content">
    <span class="eyebrow text-ink-foreground/80">Scroll</span>
    <span class="block h-14 w-px overflow-hidden bg-ink-foreground/20"><span class="scroll-cue block h-full w-full bg-ink-foreground"></span></span>
  </a>
</section>

<script>
  /**
   * The ~8 MB hero clip is decoration a still frame conveys just as well, and on
   * phones it pushed LCP past 5s (Lighthouse, emulated iPhone). So it is only
   * fetched on wide viewports, with motion allowed, no reduced-data preference,
   * and a non-slow connection — after first paint. Everyone else keeps the
   * optimized poster, which is already painted.
   */
  class HeroVideo extends HTMLElement {
    connectedCallback() {
      const video = this.querySelector('video')!
      const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection
      const slow = conn?.saveData || /(^|-)2g$|3g/.test(conn?.effectiveType ?? '')
      if (
        slow ||
        !matchMedia('(min-width: 1024px)').matches ||
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        matchMedia('(prefers-reduced-data: reduce)').matches
      )
        return

      video.addEventListener('canplay', () => video.setAttribute('data-ready', ''), { once: true })
      const start = () => {
        video.src = video.dataset.src!
        void video.play().catch(() => {})
      }
      if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 })
      else setTimeout(start, 600)
    }
  }
  customElements.define('hero-video', HeroVideo)
</script>
