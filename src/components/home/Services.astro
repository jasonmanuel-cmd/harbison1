---
import BrandPanel from '@/components/BrandPanel.astro'
import { ArrowRight } from '@lucide/astro'
import { services } from '@/lib/site'
---

<section id="services" aria-label="Buy, sell, or invest" class="scroll-mt-16">
  <ul class="grid gap-px bg-ink-foreground md:grid-cols-3">
    {
      services.map((s) => (
        <li>
          <a href={s.href} class="group relative flex h-[26rem] items-end justify-center overflow-hidden bg-ink text-ink-foreground md:h-[36rem]">
            <BrandPanel />
            <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent transition-colors duration-700 group-hover:bg-ink/40" />
            <span class="relative flex flex-col items-center gap-4 px-8 pb-10 text-center">
              <span class="font-display text-4xl font-medium tracking-[0.08em] md:text-5xl">{s.label}</span>
              <span class="grid max-w-xs grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-700 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-focus-visible:grid-rows-[1fr] group-focus-visible:opacity-100 max-md:grid-rows-[1fr] max-md:opacity-100">
                <span class="overflow-hidden text-sm leading-relaxed text-ink-foreground/85">{s.body}</span>
              </span>
              <span class="label flex items-center gap-2 text-poppy">
                Start here <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
