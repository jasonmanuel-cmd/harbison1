---
import { ArrowRight } from '@lucide/astro'
import { factLine, getSoldListings } from '@/lib/listings'
import { formatDate, formatPrice } from '@/lib/site'

// Closed sales only, straight from the listing data. These listings carry no
// photos, so the cards are typographic: price and address lead.
const sold = (await getSoldListings()).slice(0, 5)
---

{
  sold.length > 0 && (
    <section id="sold" aria-labelledby="sold-showcase-heading" class="relative scroll-mt-16 overflow-hidden bg-ink py-24 text-ink-foreground md:py-32">
      <div class="shell">
        <div data-reveal class="flex flex-col items-center text-center">
          <p class="eyebrow text-poppy">Track record</p>
          <h2 id="sold-showcase-heading" class="mt-5 text-4xl font-medium tracking-wide text-balance md:text-6xl">
            Recently <span class="italic text-poppy">sold.</span>
          </h2>
          <p class="mt-6 max-w-xl leading-relaxed text-ink-foreground/75 text-pretty">
            A selection of closed sales across Kern County. Listing attribution remains with the original listing agent or brokerage.
          </p>
        </div>

        <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 md:mt-16 md:gap-6">
          {sold.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
              <a
                href={`/property/${p.id}`}
                class="group relative flex h-full flex-col gap-5 border border-ink-foreground/15 bg-ink-foreground/[0.04] p-6 transition-[border-color,background-color,transform] duration-500 hover:-translate-y-1 hover:border-poppy/70 hover:bg-ink-foreground/[0.07] md:p-8"
              >
                <span class="flex items-center justify-between gap-4">
                  <span class="label bg-poppy px-3 py-1 text-[0.68rem] text-ink">Sold</span>
                  {p.data.soldAt && <span class="label text-[0.7rem] text-ink-foreground/70">{formatDate(p.data.soldAt)}</span>}
                </span>
                <span class="font-display text-4xl font-medium tabular-nums tracking-wide text-poppy md:text-5xl">{formatPrice(p.data.price)}</span>
                <span class="flex flex-col gap-1.5">
                  <span class="font-display text-xl tracking-wide">{p.data.address}</span>
                  <span class="label text-[0.7rem] text-ink-foreground/70">
                    {p.data.city}, CA {p.data.zip}
                  </span>
                </span>
                <span class="mt-auto border-t border-ink-foreground/15 pt-4 text-sm text-ink-foreground/75">{factLine(p.data, ' · ')}</span>
              </a>
            </li>
          ))}
          <li data-reveal style={`--reveal-delay:${(sold.length % 3) * 90}ms`}>
            <a
              href="/properties#sold"
              class="group flex h-full min-h-44 flex-col items-start justify-between gap-6 border border-poppy/50 p-6 transition-colors duration-500 hover:bg-poppy hover:text-ink md:p-8"
            >
              <span class="font-display text-2xl tracking-wide">See every sale and what’s available now.</span>
              <span class="label inline-flex items-center gap-3">
                All properties <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  )
}
