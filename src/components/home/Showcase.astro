---
import { Image } from 'astro:assets'
import { ChevronLeft, ChevronRight } from '@lucide/astro'
import { cover, factLine, getActiveListings } from '@/lib/listings'
import { formatPrice, pad2 } from '@/lib/site'

// Lead with the flagship properties.
const listings = (await getActiveListings()).toSorted((a, b) => b.data.price - a.data.price)
---

<section id="listings" aria-labelledby="listings-heading" class="scroll-mt-16 bg-background pt-24 md:pt-32">
  <div data-reveal class="shell flex flex-col items-center text-center">
    <p class="eyebrow text-muted-foreground">Tehachapi & Bakersfield</p>
    <h2 id="listings-heading" class="mt-5 text-4xl font-medium tracking-wide text-balance md:text-6xl">Property Collection</h2>
  </div>

  <listing-showcase>
    <div
      role="region"
      aria-roledescription="carousel"
      aria-label="Featured properties"
      tabindex="0"
      class="relative mt-14 h-[78svh] min-h-[32rem] touch-pan-y overflow-hidden bg-ink text-ink-foreground outline-none md:mt-16"
    >
      {
        listings.map((item, i) => (
          <div data-slide aria-hidden={i !== 0 ? 'true' : undefined} data-active={i === 0 ? '' : undefined} class="absolute inset-0 opacity-0 transition-opacity duration-[1400ms] ease-in-out data-[active]:opacity-100">
            <Image
              src={cover(item)}
              alt={`${item.data.address}, ${item.data.city}, CA`}
              widths={[828, 1280, 1920, 2560]}
              sizes="100vw"
              loading={i < 2 ? 'eager' : 'lazy'}
              class="kenburns h-full w-full object-cover"
            />
          </div>
        ))
      }
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-ink/10"></div>

      <div class="shell absolute inset-x-0 bottom-0 flex flex-col gap-8 pb-10 md:pb-14 lg:flex-row lg:items-end lg:justify-between">
        <div aria-live="polite" class="grid max-w-3xl">
          {
            listings.map((item, i) => (
              <a data-caption href={`/property/${item.id}`} hidden={i !== 0} class="rise group col-start-1 row-start-1 block">
                <p class="eyebrow text-poppy">{item.data.neighborhood ?? `${item.data.city}, CA`}</p>
                <h3 class="mt-3 text-4xl font-medium tracking-wide text-balance decoration-poppy decoration-2 underline-offset-8 group-hover:underline md:text-6xl">{item.data.address}</h3>
                <p class="mt-3 text-ink-foreground/85">{item.data.city}, CA {item.data.zip}</p>
                <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
                  <span class="font-display text-2xl tracking-wide md:text-3xl">{formatPrice(item.data.price)}</span>
                  <span class="label text-ink-foreground/80">{factLine(item.data)}</span>
                </div>
                <p class="mt-4 hidden max-w-xl text-sm leading-relaxed text-ink-foreground/75 md:block">{item.data.blurb}</p>
              </a>
            ))
          }
        </div>

        <div class="flex items-center gap-4 self-start lg:self-end">
          <button type="button" data-prev class="flex size-12 items-center justify-center rounded-full border border-ink-foreground/50 transition-colors hover:border-ink-foreground hover:bg-ink-foreground hover:text-ink">
            <ChevronLeft class="size-5" aria-hidden="true" /><span class="sr-only">Previous property</span>
          </button>
          <span class="label min-w-20 text-center tabular-nums">
            <span data-index>01</span> <span class="text-ink-foreground/60">|</span> {pad2(listings.length)}
          </span>
          <button type="button" data-next class="flex size-12 items-center justify-center rounded-full border border-ink-foreground/50 transition-colors hover:border-ink-foreground hover:bg-ink-foreground hover:text-ink">
            <ChevronRight class="size-5" aria-hidden="true" /><span class="sr-only">Next property</span>
          </button>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-[90rem] py-10 md:py-12">
      <ul data-strip class="no-scrollbar relative flex snap-x snap-mandatory gap-4 overflow-x-auto px-[calc(50%-7rem)] pb-4 md:px-[calc(50%-8rem)]" aria-label="All properties">
        {
          listings.map((item, i) => (
            <li class="w-56 shrink-0 snap-center md:w-64">
              <button type="button" data-thumb={i} aria-current={i === 0 ? 'true' : undefined} class="group flex w-full flex-col text-left">
                <span class="relative block aspect-[4/3] overflow-hidden bg-muted ring-2 ring-transparent ring-offset-2 transition-shadow group-aria-[current=true]:ring-poppy">
                  <Image src={cover(item)} alt="" widths={[256, 512]} sizes="256px" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                </span>
                <span class="mt-3 truncate font-display text-lg tracking-wide">{item.data.address}</span>
                <span class="label text-muted-foreground">{item.data.city} · {formatPrice(item.data.price)}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-wrap justify-center gap-3 px-5">
        <a href="/properties" class="pill bg-ink text-ink-foreground hover:bg-poppy hover:text-ink">Explore all properties</a>
        <a href="#contact" class="pill border border-ink/30 hover:border-ink hover:bg-ink hover:text-ink-foreground">Ask about a property</a>
      </div>
    </div>
  </listing-showcase>
</section>

<script>
  class ListingShowcase extends HTMLElement {
    #current = 0
    #abort = new AbortController()

    connectedCallback() {
      const { signal } = this.#abort
      const region = this.querySelector<HTMLElement>('[role=region]')!
      this.querySelector('[data-prev]')!.addEventListener('click', () => this.go(this.#current - 1), { signal })
      this.querySelector('[data-next]')!.addEventListener('click', () => this.go(this.#current + 1), { signal })
      this.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) =>
        b.addEventListener('click', () => this.go(Number(b.dataset.thumb)), { signal }),
      )

      region.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'ArrowLeft') this.go(this.#current - 1)
          if (e.key === 'ArrowRight') this.go(this.#current + 1)
        },
        { signal },
      )

      // Swipe
      let x0: number | null = null
      region.addEventListener('pointerdown', (e) => (x0 = e.clientX), { signal })
      region.addEventListener(
        'pointerup',
        (e) => {
          if (x0 === null) return
          const dx = e.clientX - x0
          if (Math.abs(dx) > 50) this.go(this.#current + (dx < 0 ? 1 : -1))
          x0 = null
        },
        { signal },
      )

      // When a swipe/drag of the strip settles, the card snapped to centre becomes active.
      const strip = this.querySelector<HTMLElement>('[data-strip]')!
      let settle: number | undefined
      strip.addEventListener(
        'scroll',
        () => {
          clearTimeout(settle)
          settle = window.setTimeout(() => {
            const mid = strip.scrollLeft + strip.clientWidth / 2
            let best = 0
            let dist = Infinity
            Array.from(strip.children).forEach((el, i) => {
              const d = Math.abs((el as HTMLElement).offsetLeft + (el as HTMLElement).offsetWidth / 2 - mid)
              if (d < dist) {
                dist = d
                best = i
              }
            })
            if (best !== this.#current) this.go(best)
          }, 120)
        },
        { signal },
      )
    }

    disconnectedCallback() {
      this.#abort.abort()
    }

    go(next: number) {
      const slides = this.querySelectorAll<HTMLElement>('[data-slide]')
      const captions = this.querySelectorAll<HTMLElement>('[data-caption]')
      const thumbs = this.querySelectorAll<HTMLElement>('[data-thumb]')
      const n = slides.length
      this.#current = (next + n) % n
      slides.forEach((s, i) => {
        const on = i === this.#current
        s.toggleAttribute('data-active', on)
        s.setAttribute('aria-hidden', String(!on))
        if (on) s.querySelector('img')?.setAttribute('loading', 'eager')
      })
      captions.forEach((c, i) => (c.hidden = i !== this.#current))
      thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === this.#current)))
      this.querySelector('[data-index]')!.textContent = String(this.#current + 1).padStart(2, '0')

      const strip = this.querySelector<HTMLElement>('[data-strip]')!
      const item = strip.children[this.#current] as HTMLElement | undefined
      if (item) strip.scrollTo({ left: item.offsetLeft + item.offsetWidth / 2 - strip.clientWidth / 2, behavior: 'smooth' })
    }
  }
  customElements.define('listing-showcase', ListingShowcase)
</script>
