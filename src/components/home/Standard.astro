---
import { getActiveListings, getAreas, marketStats } from '@/lib/listings'
import { formatPriceShort } from '@/lib/site'

const [active, areas] = await Promise.all([getActiveListings(), getAreas()])
const stats = marketStats(active)
const items = [
  { value: stats.count, label: 'Active properties' },
  { value: areas.length, label: 'Neighborhoods covered' },
  { value: 24, suffix: ' hr', label: 'Typical reply time' },
]
---

<section id="standard" aria-labelledby="standard-heading" class="bg-secondary py-24 md:py-32">
  <div class="mx-auto max-w-5xl px-5 text-center md:px-8">
    <div data-reveal>
      <p class="eyebrow text-muted-foreground">Setting the standard</p>
      <h2 id="standard-heading" class="mt-5 text-4xl font-medium tracking-wide text-balance md:text-6xl">Real estate, done the right way.</h2>
      <p class="mx-auto mt-6 max-w-2xl leading-relaxed text-muted-foreground text-pretty">
        Practical advice, direct communication, and a clear next step — for buyers, sellers, and investors across Tehachapi, Bakersfield, and all of
        Kern County.
      </p>
    </div>
    <dl class="mt-16 grid gap-12 sm:grid-cols-3">
      {
        items.map((s, i) => (
          <div data-reveal style={`--reveal-delay:${i * 120}ms`} class="flex flex-col-reverse items-center gap-3">
            <dt class="label text-muted-foreground">{s.label}</dt>
            <dd class="font-display text-5xl font-medium tabular-nums md:text-6xl">
              <span data-count={s.value}>{s.value}</span>
              {s.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
    <p data-reveal class="mt-14 text-sm text-muted-foreground">
      Current collection: {stats.homes} homes and {stats.land} land parcels, from {formatPriceShort(stats.min)} to {formatPriceShort(stats.max)} ·
      <a href="/properties" class="font-semibold text-foreground underline decoration-poppy decoration-2 underline-offset-4 hover:text-poppy-deep">browse all</a>
    </p>
  </div>
</section>
