---
import { ArrowUpRight, CirclePlay, MapPin, Camera, Users, BriefcaseBusiness } from '@lucide/astro'
import { contact } from '@/lib/site'
import { t, type Lang } from '@/i18n'

interface Props {
  lang?: Lang
}
const { lang = 'en' } = Astro.props
const ui = t(lang)
const copy = ui.connect
const profiles = [
  { label: 'YouTube', detail: copy.youtube, href: contact.youtube, icon: CirclePlay },
  { label: 'Google Business', detail: copy.google, href: contact.reviews, icon: MapPin },
  { label: 'Instagram', detail: copy.instagram, href: contact.instagram, icon: Camera },
  { label: 'Facebook', detail: copy.facebook, href: contact.facebook, icon: Users },
  { label: 'LinkedIn', detail: copy.linkedin, href: contact.linkedin, icon: BriefcaseBusiness },
]
---
    <section id="connect" class="connections wrap" aria-labelledby="connect-title">
      <p class="kicker">{copy.kicker}</p><h2 id="connect-title">{copy.title}</h2><p class="subtext">{copy.text}</p>
      <div class="profile-links">
        {profiles.map(({ label, detail, href, icon: Icon }) => <a class="profile-link" href={href} target="_blank" rel="noopener noreferrer"><Icon class="profile-icon" size={25} /><span><strong>{label}</strong><small>{detail}</small></span><ArrowUpRight class="profile-arrow" size={21} /><span class="sr-only">{ui.newTab}</span></a>)}
      </div>
      <a class="contact-button" href={contact.zillowReviews} target="_blank" rel="noopener noreferrer">{copy.zillow} <ArrowUpRight size={19} /></a>
      <div class="direct-contact"><p>{copy.question}</p><a href={contact.phoneHref}>{contact.phone}</a><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
    </section>
