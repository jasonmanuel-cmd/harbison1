---
import { Image } from 'astro:assets'
import { ArrowUpRight } from '@lucide/astro'
import Landing from '@/layouts/Landing.astro'
import ProfileLinks from '@/components/ProfileLinks.astro'
import headshot from '@/assets/headshot.webp'
import aboutEn from '@/data/about.json'
import aboutEs from '@/data/about.es.json'
import { contact } from '@/lib/site'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const copy = t(lang)
const page = copy.about
const about = lang === 'es' ? aboutEs : aboutEn
---
<Landing title={page.title} description={page.description} image={headshot} imageAlt="Nathanael Harbison">
  <section class="intro wrap" aria-labelledby="bio-title">
    <div><p class="kicker">{page.kicker}</p><h1 id="bio-title">{page.h1Line1}<br /><span>{page.h1Line2}</span></h1><p class="intro-text">{page.intro}</p><a class="contact-button" href={contact.phoneHref}>{page.call} <ArrowUpRight size={19} /></a><p class="license">{page.license}{contact.dre}</p></div>
    <figure class="portrait"><Image src={headshot} alt={page.portraitAlt} widths={[400,640,900]} sizes="(max-width:760px) 90vw,42vw" loading="eager" fetchpriority="high" /><figcaption>Nathanael Harbison <span>Harbison Standard</span></figcaption></figure>
  </section>
  <section class="wrap bio-body" aria-labelledby="background-title"><p class="kicker">{page.backgroundKicker}</p><h2 id="background-title">{page.backgroundTitle}</h2><div class="bio-copy" style="max-width:820px;margin-top:28px">{about.paragraphs.map(paragraph => <p>{paragraph}</p>)}<p><a href={contact.licenseUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{page.licenseLink(contact.dre)}<span class="sr-only">{copy.newTab}</span></a></p></div></section>
  <section class="standard" aria-labelledby="values-title"><div class="wrap"><p class="kicker">{page.expectKicker}</p><h2 id="values-title">{page.expectTitle}</h2><dl class="grid gap-8 mt-8 sm:grid-cols-2">{page.values.map(value => <div><dt class="font-display text-xl font-semibold">{value.title}</dt><dd class="mt-3 leading-relaxed">{value.body}</dd></div>)}</dl></div></section>
  <ProfileLinks lang={lang} />
</Landing>

<style>
  #background-title {
    /* Keep descenders clear and headings readable at browser text zoom. */
    letter-spacing: normal;
    font-variant-ligatures: none;
    line-height: 1.35;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
</style>
