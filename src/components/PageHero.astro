---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro'

interface Props {
  eyebrow: string
  title: string
  intro?: string
  crumbs?: Crumb[]
}
const { eyebrow, title, intro, crumbs } = Astro.props
---

<section class="relative isolate overflow-hidden bg-ink pt-32 text-ink-foreground md:pt-44">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/70 via-ink/40 to-ink"></div>
  <div class="shell relative pb-16 md:pb-24">
    {crumbs && <Breadcrumbs crumbs={crumbs} class="rise mb-8" />}
    <p class="eyebrow rise text-ink-foreground/60">{eyebrow}</p>
    <h1 class="rise mt-5 max-w-4xl text-4xl font-medium leading-[1.08] tracking-wide text-balance md:text-6xl" style="animation-delay:80ms">
      {title}
    </h1>
    {intro && <p class="rise mt-6 max-w-2xl text-lg leading-relaxed text-ink-foreground/75 text-pretty" style="animation-delay:160ms">{intro}</p>}
    <slot />
  </div>
</section>
