---
import { Image } from 'astro:assets'
import { ArrowUpRight } from '@lucide/astro'
import Base from '@/layouts/Base.astro'
import logo from '@/assets/harbison-logo.webp'
import PrivacyNotice from '@/components/PrivacyNotice.astro'
import { contact } from '@/lib/site'
import { langFromPath, pathFor, t } from '@/i18n'
type Props = import('astro/types').ComponentProps<typeof Base>
const lang = langFromPath(Astro.url.pathname)
const ui = t(lang)
const otherLang = lang === 'en' ? 'es' : 'en'
const homePath = pathFor('/', lang)
const aboutPath = pathFor('/about', lang)
const switchPath = pathFor(Astro.url.pathname, otherLang)
---
<Base {...Astro.props} lang={lang} i18n bare nativeNavigation><div class="landing">
    <header class="landing-header wrap">
      <a href={homePath} aria-label={ui.header.homeAria}><Image src={logo} alt={ui.header.logoAlt} width={280} class="brand" /></a>
      <nav aria-label={ui.header.navAria}><a href={homePath} aria-current={Astro.url.pathname === homePath ? "page" : undefined}>{ui.header.home}</a><a href={aboutPath} aria-current={Astro.url.pathname === aboutPath ? "page" : undefined}>{ui.header.meet}</a><a class="header-contact" href={`mailto:${contact.email}`}>{ui.header.email} <ArrowUpRight size={17} /></a><a class="lang-switch" href={switchPath} hreflang={otherLang} lang={otherLang} data-lang-pref={otherLang} aria-label={ui.switchAria}>{ui.switchLabel}</a></nav>
    </header>
<slot />
    <footer class="landing-footer wrap"><span>© {new Date().getFullYear()} Harbison Standard</span><span>Nathanael Harbison · REALTOR® · DRE #{contact.dre}</span><span>{ui.footer.equalHousing}</span><PrivacyNotice lang={lang} /></footer>
</div></Base>
<style is:global>
.landing #top{background-image:none}
.landing .home-brand,.landing .connections,.landing .bio-body,.landing .standard{content-visibility:auto;contain-intrinsic-size:auto 600px}
.landing{background:#0c1a3a;color:#fff}.wrap{width:min(1120px,90%);margin-inline:auto}
.landing-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:28px;border-bottom:1px solid #ffffff26}.brand{width:220px;height:auto}.header-contact{display:flex;align-items:center;gap:10px;font-size:14px;color:#f1d68a}
.intro{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:70px;padding-block:80px 88px}.kicker{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.17em;color:#f1d68a;line-height:1.8}h1{font-size:clamp(40px,4.5vw,64px);line-height:1.12;letter-spacing:-.045em;margin:22px 0 26px;font-weight:600}h1 span,h2 span{color:#f1d68a}.intro-text{font-size:18px;line-height:1.8;color:#d7dce5;max-width:540px}.contact-button{display:inline-flex;gap:30px;align-items:center;background:#f1d68a;color:#0c1a3a;padding:15px 24px;border-radius:3px;margin-top:28px;font-weight:700}.license{font-size:12px;color:#bdc6d7;margin-top:18px}.portrait{margin:0}.portrait img{width:100%;height:auto;aspect-ratio:1/1.12;object-fit:cover;object-position:center;border-radius:3px}.portrait figcaption{display:flex;justify-content:space-between;gap:15px;margin-top:16px;font-size:12px;color:#d7dce5}.portrait figcaption span{color:#f1d68a}
.standard{background:#f5f3ee;color:#0c1a3a;padding-block:65px}.standard .kicker{color:#735a24}.standard-inner{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center}h2{font-size:clamp(28px,3vw,38px);line-height:1.25;letter-spacing:-.035em;font-weight:600;margin-top:16px}.standard h2 span{color:#735a24}.standard-copy{font-size:17px;line-height:1.8}.standard-copy p+p{margin-top:16px}
.connections{padding-block:72px 60px}.subtext{color:#bdc6d7;line-height:1.7;margin-top:16px}.profile-links{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:34px}.profile-link{display:flex;align-items:center;gap:20px;padding:22px;border:1px solid #ffffff30;border-radius:3px;transition:background .2s,border-color .2s}.profile-link:hover{background:#13254f;border-color:#f1d68a}.profile-icon{color:#f1d68a;flex-shrink:0}.profile-link strong{display:block;font-size:18px;font-weight:600}.profile-link small{display:block;color:#bdc6d7;font-size:14px;margin-top:5px;line-height:1.5}.profile-arrow{margin-left:auto;flex-shrink:0;color:#f1d68a}.direct-contact{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:35px;font-size:15px}.direct-contact p{color:#bdc6d7}.direct-contact a{text-decoration:underline;text-underline-offset:4px;overflow-wrap:anywhere}.landing-footer{border-top:1px solid #ffffff26;padding-block:25px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 24px;color:#bdc6d7;font-size:11px}a:focus-visible{outline:2px solid #f1d68a;outline-offset:5px}
@media(max-width:760px){.brand{width:165px}.header-contact{font-size:12px}.landing-header{padding-block:22px}.intro{grid-template-columns:1fr;gap:38px;padding-block:45px}.intro-text{font-size:16px}.portrait{width:100%;max-width:440px}.standard{padding-block:42px}.standard-inner{grid-template-columns:1fr;gap:25px}.standard-copy{font-size:16px}.connections{padding-block:45px}.profile-links{grid-template-columns:1fr}.profile-link{padding:19px}.portrait figcaption{font-size:11px}.direct-contact{flex-direction:column}.landing-footer{flex-direction:column}}
@media(prefers-reduced-motion:reduce){.profile-link{transition:none}}

.landing-header nav{display:flex;align-items:center;gap:24px;font-size:14px}.landing-header nav a[aria-current=page]{color:#f1d68a}.landing-header{position:relative;z-index:20}.home-brand{padding-block:72px}.brand-values{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:35px}.brand-values h3{font-size:21px;color:#f1d68a;margin-bottom:12px}.brand-values p{line-height:1.8;color:#d7dce5}.bio-copy p+p{margin-top:22px}.bio-copy{font-size:17px;line-height:1.9;color:#d7dce5}.bio-body{padding-bottom:65px}.videos{background:#f5f3ee;color:#0c1a3a;padding-block:64px}.videos .kicker{color:#735a24}.video-frame{width:100%;aspect-ratio:16/9;border:0;margin-block:28px 20px;border-radius:3px;background:#0c1a3a}.video-channel{display:inline-flex;align-items:center;gap:12px;font-weight:700;text-decoration:underline;text-underline-offset:5px}
@media(max-width:760px){.landing-header{align-items:flex-start;gap:16px}.landing-header nav{gap:10px 16px;flex-wrap:wrap;justify-content:flex-end;font-size:12px}.landing-header nav .header-contact{display:none}.brand-values{grid-template-columns:1fr}.home-brand,.videos{padding-block:45px}}

.landing-header nav a{display:inline-flex;align-items:center;min-height:44px}.landing-header nav .lang-switch{border:1px solid #f1d68a66;border-radius:999px;padding-inline:14px;color:#f1d68a;font-weight:700;white-space:nowrap}.landing-header nav .lang-switch:hover{background:#f1d68a;color:#0c1a3a}.landing-header nav{min-width:0}.intro>div,.portrait,.standard-inner>div{min-width:0}.intro h1{overflow-wrap:anywhere}.landing-footer{padding-bottom:max(25px,env(safe-area-inset-bottom))}
@media(min-width:761px) and (max-width:1024px){.intro{gap:32px}.intro h1{font-size:44px}.brand-values{gap:24px}.profile-link{gap:12px;padding:18px}}
@media(max-width:380px){.brand{width:135px}.landing-header nav{font-size:11px;gap:4px 12px}.intro h1{font-size:36px}}
</style>
