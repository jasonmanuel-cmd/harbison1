---
import '@fontsource-variable/nunito-sans'
import nunitoFont from '@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url'
import '@/styles/global.css'

import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import QuickContact from '@/components/QuickContact.astro'
import { SITE_NAME } from '@/lib/site'
import { abs, agentSchema, graph, personSchema } from '@/lib/seo'
import { LANG_STORAGE_KEY, langFromPath, pathFor, t, type Lang } from '@/i18n'
import headshot from '@/assets/headshot.webp'

interface Props {
  /** Page language. Defaults to the language implied by the URL (/es/... is Spanish). */
  lang?: Lang
  /** The page has an English and a Spanish version: emit hreflang links and the language memory. */
  i18n?: boolean
  nativeNavigation?: boolean
  title: string
  description: string
  /** Social share image. Defaults to the site hero. */
  image?: ImageMetadata | string
  imageAlt?: string
  jsonLd?: object | object[]
  noindex?: boolean
  /** Hide the global header/footer chrome (used by /hq). */
  bare?: boolean
  /** Transparent header over a dark hero. */
  overlayHeader?: boolean
  /** The page's opening photo. Preloaded so it downloads before the stylesheet and scripts finish. */
  heroImage?: ImageMetadata
}

const { title, description, image, imageAlt, jsonLd, noindex = false, bare = false, overlayHeader = true, heroImage, nativeNavigation = false, i18n = false } = Astro.props
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname)
const here = Astro.url.pathname
const preloaded = heroImage && (await getImage({ src: heroImage, widths: [480, 800, 1200, 2000], sizes: '(max-width: 767px) 80vw, 100vw', format: 'webp', quality: 60 }))

const canonical = abs(Astro.url.pathname.replace(/\/$/, '') || '/')
// Search results cut descriptions near 160 characters; trim at a word boundary so the cut is ours.
const clamp = (text: string, max = 158) => {
  const t = text.replace(/\s+/g, ' ').trim()
  return t.length <= max ? t : `${t.slice(0, max - 1).replace(/\s+\S*$/, '')}…`
}
const metaDescription = clamp(description)
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`

let ogImage = abs('/images/hero-1600.webp')
if (image && typeof image !== 'string') {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  ogImage = abs(og.src)
} else if (typeof image === 'string') {
  ogImage = abs(image)
}

// The organisation and the agent, as one @graph on every page.
const portrait = abs((await getImage({ src: headshot, width: 600, format: 'jpeg' })).src)
const identity = graph(agentSchema(abs('/images/hero-1600.webp')), personSchema(portrait))
const ld = [identity, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---

<!doctype html>
<html lang={lang} class="no-js" data-native-navigation={nativeNavigation || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c1a3a" />
    <link rel="preload" as="font" type="font/woff2" href={nunitoFont} crossorigin="anonymous" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {
      i18n && (
        <>
          <link rel="alternate" hreflang="en" href={abs(pathFor(here, 'en'))} />
          <link rel="alternate" hreflang="es" href={abs(pathFor(here, 'es'))} />
          <link rel="alternate" hreflang="x-default" href={abs(pathFor(here, 'en'))} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {preloaded && <link rel="preload" as="image" type="image/webp" imagesrcset={preloaded.srcSet.attribute} imagesizes="(max-width: 767px) 80vw, 100vw" fetchpriority="high" />}
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="Tehachapi, California" />
    <meta name="geo.position" content="35.0680;-118.4468" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    {i18n && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <script is:inline>
      document.documentElement.classList.remove('no-js')
      // The client router copies <html> attributes from each new page, so strip it again after every swap.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.remove('no-js'))
    </script>
    {
      i18n && lang === 'en' && (
        // A visitor who chose Spanish earlier lands on the Spanish version of this page. Crawlers keep no storage, so they always see English here.
        <script is:inline define:vars={{ key: LANG_STORAGE_KEY }}>
          {`try{if(localStorage.getItem(key)==='es'){var p=location.pathname.replace(/\\/$/,'');location.replace('/es'+(p==='/'||p===''?'':p)+location.search+location.hash)}}catch(e){}`}
        </script>
      )
    }
    {
      !noindex && (
        <script is:inline>
          {`function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"398cd80eb0d6d2a7ebd652d00db3bb8"})});`}
        </script>
      )
    }
    {!nativeNavigation && <ClientRouter />}
  </head>
  <body>
    <a
      href="#main"
      class="label sr-only z-[100] bg-poppy px-5 py-3 text-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >{t(lang).skipToContent}</a
    >
    {!bare && <SiteHeader overlay={overlayHeader} />}
    <main id="main" class="relative">
      <slot />
    </main>
    {
      !bare && (
        <>
          <SiteFooter />
          <QuickContact />
        </>
      )
    }

    <script>
      import { initAnalytics, trackPageView } from '@/scripts/analytics'
      import { LANG_STORAGE_KEY } from '@/i18n'

      // Scroll reveal. Re-bound on every client-side navigation.
      let io: IntersectionObserver | undefined
      function bindReveal() {
        io?.disconnect()
        io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.setAttribute('data-shown', '')
                io?.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        )
        document.querySelectorAll('[data-reveal]:not([data-shown])').forEach((el) => io!.observe(el))
      }

      // Animated counters: <span data-count="14">14</span>
      function bindCounters() {
        const els = document.querySelectorAll<HTMLElement>('[data-count]')
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            obs.unobserve(e.target)
            const el = e.target as HTMLElement
            const end = Number(el.dataset.count)
            const t0 = performance.now()
            const tick = (t: number) => {
              const p = Math.min((t - t0) / 1400, 1)
              el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 4))))
              if (p < 1) requestAnimationFrame(tick)
            }
            requestAnimationFrame(tick)
          }
        })
        els.forEach((el) => obs.observe(el))
      }

      // Remember the language the visitor picks with the header switch.
      document.addEventListener('click', (event) => {
        const link = (event.target as Element | null)?.closest<HTMLElement>('[data-lang-pref]')
        if (!link) return
        try {
          localStorage.setItem(LANG_STORAGE_KEY, link.dataset.langPref!)
        } catch {
          // Storage can be unavailable (private mode); the switch still works, it just isn't remembered.
        }
      })

      const isAdmin = () => location.pathname.startsWith('/hq')

      function initPage() {
        bindReveal()
        bindCounters()
        // Admin views would pollute the visitor data, so HQ is never tracked.
        if (!isAdmin() && !['localhost', '127.0.0.1'].includes(location.hostname)) {
          initAnalytics()
          trackPageView(document.title)
        }
      }
      document.addEventListener('astro:page-load', initPage)
      if (document.documentElement.hasAttribute('data-native-navigation')) initPage()
    </script>
  </body>
</html>
