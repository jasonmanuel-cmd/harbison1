---
import '@fontsource-variable/syne'
import '@fontsource-variable/nunito-sans'
import '@/styles/global.css'

import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import QuickContact from '@/components/QuickContact.astro'
import { SITE_NAME, SITE_URL, TAGLINE, contact, serviceArea } from '@/lib/site'
import headshot from '@/assets/headshot.webp'

interface Props {
  title: string
  description: string
  /** Social share image. Defaults to the site hero. */
  image?: ImageMetadata | string
  imageAlt?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
  /** Hide the global header/footer chrome (used by /hq). */
  bare?: boolean
  /** Transparent header over a dark hero. */
  overlayHeader?: boolean
}

const { title, description, image, imageAlt, jsonLd, noindex = false, bare = false, overlayHeader = true } = Astro.props

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE_URL).href
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`

let ogImage = new URL('/images/hero-1600.webp', SITE_URL).href
if (image && typeof image !== 'string') {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  ogImage = new URL(og.src, SITE_URL).href
} else if (typeof image === 'string') {
  ogImage = new URL(image, SITE_URL).href
}

const agent = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${SITE_URL}/#agent`,
  name: `${SITE_NAME} — ${contact.name}`,
  url: SITE_URL,
  telephone: contact.phoneE164,
  email: contact.email,
  image: new URL((await getImage({ src: headshot, width: 600, format: 'jpeg' })).src, SITE_URL).href,
  slogan: TAGLINE,
  priceRange: '$$',
  address: { '@type': 'PostalAddress', addressLocality: 'Tehachapi', addressRegion: 'CA', addressCountry: 'US' },
  geo: { '@type': 'GeoCoordinates', latitude: 35.068, longitude: -118.4468 },
  areaServed: serviceArea,
  founder: { '@type': 'Person', name: contact.name, jobTitle: 'REALTOR®' },
  identifier: { '@type': 'PropertyValue', name: 'California DRE', value: contact.dre },
  sameAs: [contact.youtube, contact.instagram, contact.facebook, contact.linkedin],
}
const ld = [agent, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c1a3a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="Tehachapi, California" />
    <meta name="geo.position" content="35.0680;-118.4468" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    {!noindex && ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <script is:inline>
      document.documentElement.classList.remove('no-js')
      // The client router copies <html> attributes from each new page, so strip it again after every swap.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.remove('no-js'))
    </script>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="label sr-only z-[100] bg-poppy px-5 py-3 text-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Skip to content</a
    >
    {!bare && <SiteHeader overlay={overlayHeader} />}
    <main id="main" class="relative">
      <slot />
    </main>
    {
      !bare && (
        <>
          <SiteFooter />
          <QuickContact />
        </>
      )
    }

    <script>
      import { initAnalytics, trackPageView } from '@/scripts/analytics'

      // Scroll reveal. Re-bound on every client-side navigation.
      let io: IntersectionObserver | undefined
      function bindReveal() {
        io?.disconnect()
        io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.setAttribute('data-shown', '')
                io?.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        )
        document.querySelectorAll('[data-reveal]:not([data-shown])').forEach((el) => io!.observe(el))
      }

      // Animated counters: <span data-count="14">14</span>
      function bindCounters() {
        const els = document.querySelectorAll<HTMLElement>('[data-count]')
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            obs.unobserve(e.target)
            const el = e.target as HTMLElement
            const end = Number(el.dataset.count)
            const t0 = performance.now()
            const tick = (t: number) => {
              const p = Math.min((t - t0) / 1400, 1)
              el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 4))))
              if (p < 1) requestAnimationFrame(tick)
            }
            requestAnimationFrame(tick)
          }
        })
        els.forEach((el) => obs.observe(el))
      }

      const isAdmin = () => location.pathname.startsWith('/hq')

      document.addEventListener('astro:page-load', () => {
        bindReveal()
        bindCounters()
        // Admin views would pollute the visitor data, so HQ is never tracked.
        if (!isAdmin()) {
          initAnalytics()
          trackPageView(document.title)
        }
      })
    </script>
  </body>
</html>
