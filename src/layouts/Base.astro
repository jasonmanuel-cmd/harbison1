---
import '@fontsource-variable/syne'
import '@fontsource-variable/nunito-sans'
import '@/styles/global.css'

import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import QuickContact from '@/components/QuickContact.astro'
import { SITE_NAME } from '@/lib/site'
import { abs, agentSchema, graph, personSchema } from '@/lib/seo'
import headshot from '@/assets/headshot.webp'

interface Props {
  title: string
  description: string
  /** Social share image. Defaults to the site hero. */
  image?: ImageMetadata | string
  imageAlt?: string
  jsonLd?: object | object[]
  noindex?: boolean
  /** Hide the global header/footer chrome (used by /hq). */
  bare?: boolean
  /** Transparent header over a dark hero. */
  overlayHeader?: boolean
  /** The page's opening photo. Preloaded so it downloads before the stylesheet and scripts finish. */
  heroImage?: ImageMetadata
}

const { title, description, image, imageAlt, jsonLd, noindex = false, bare = false, overlayHeader = true, heroImage } = Astro.props
const preloaded = heroImage && (await getImage({ src: heroImage, widths: [480, 800, 1200, 2000], sizes: '(max-width: 767px) 80vw, 100vw', format: 'webp', quality: 60 }))

const canonical = abs(Astro.url.pathname.replace(/\/$/, '') || '/')
// Search results cut descriptions near 160 characters; trim at a word boundary so the cut is ours.
const clamp = (text: string, max = 158) => {
  const t = text.replace(/\s+/g, ' ').trim()
  return t.length <= max ? t : `${t.slice(0, max - 1).replace(/\s+\S*$/, '')}…`
}
const metaDescription = clamp(description)
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`

let ogImage = abs('/images/hero-1600.webp')
if (image && typeof image !== 'string') {
  const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  ogImage = abs(og.src)
} else if (typeof image === 'string') {
  ogImage = abs(image)
}

// The organisation and the agent, as one @graph on every page.
const portrait = abs((await getImage({ src: headshot, width: 600, format: 'jpeg' })).src)
const identity = graph(agentSchema(abs('/images/hero-1600.webp')), personSchema(portrait))
const ld = [identity, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c1a3a" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {preloaded && <link rel="preload" as="image" type="image/webp" imagesrcset={preloaded.srcSet.attribute} imagesizes="(max-width: 767px) 80vw, 100vw" fetchpriority="high" />}
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="Tehachapi, California" />
    <meta name="geo.position" content="35.0680;-118.4468" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <script is:inline>
      document.documentElement.classList.remove('no-js')
      // The client router copies <html> attributes from each new page, so strip it again after every swap.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.remove('no-js'))
    </script>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="label sr-only z-[100] bg-poppy px-5 py-3 text-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Skip to content</a
    >
    {!bare && <SiteHeader overlay={overlayHeader} />}
    <main id="main" class="relative">
      <slot />
    </main>
    {
      !bare && (
        <>
          <SiteFooter />
          <QuickContact />
        </>
      )
    }

    <script>
      import { initAnalytics, trackPageView } from '@/scripts/analytics'

      // Scroll reveal. Re-bound on every client-side navigation.
      let io: IntersectionObserver | undefined
      function bindReveal() {
        io?.disconnect()
        io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.setAttribute('data-shown', '')
                io?.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        )
        document.querySelectorAll('[data-reveal]:not([data-shown])').forEach((el) => io!.observe(el))
      }

      // Animated counters: <span data-count="14">14</span>
      function bindCounters() {
        const els = document.querySelectorAll<HTMLElement>('[data-count]')
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            obs.unobserve(e.target)
            const el = e.target as HTMLElement
            const end = Number(el.dataset.count)
            const t0 = performance.now()
            const tick = (t: number) => {
              const p = Math.min((t - t0) / 1400, 1)
              el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 4))))
              if (p < 1) requestAnimationFrame(tick)
            }
            requestAnimationFrame(tick)
          }
        })
        els.forEach((el) => obs.observe(el))
      }

      const isAdmin = () => location.pathname.startsWith('/hq')

      document.addEventListener('astro:page-load', () => {
        bindReveal()
        bindCounters()
        // Admin views would pollute the visitor data, so HQ is never tracked.
        if (!isAdmin()) {
          initAnalytics()
          trackPageView(document.title)
        }
      })
    </script>
    <!-- Simple Analytics: privacy-first, honours Do Not Track -->
    <script is:inline data-collect-dnt="true">
      // Load after the page has finished and the browser is idle, so the analytics
      // script never competes with the first paint on slow phones.
      window.addEventListener('load', () => {
        const start = () => {
          const s = document.createElement('script')
          s.async = true
          s.src = 'https://scripts.simpleanalyticscdn.com/latest.js'
          s.setAttribute('data-collect-dnt', 'true')
          document.body.appendChild(s)
        }
        'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 4000 }) : setTimeout(start, 2000)
      })
    </script>
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" width="1" height="1" referrerpolicy="no-referrer-when-downgrade" /></noscript>
  </body>
</html>
