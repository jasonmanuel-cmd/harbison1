{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "images:manifest": "node scripts/generate-image-manifest.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs",
    "prebuild": "node scripts/generate-image-manifest.mjs && node scripts/generate-responsive-images.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audit:contrast": "node scripts/contrast.mjs && node scripts/opacity.mjs",
    "audit:contrast-scan": "node scripts/contrast-scan.mjs",
    "prune:originals": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prune-originals.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
